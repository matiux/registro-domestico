{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/yaml": "8.0.*",
        "webmozart/assert": "^1.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "matiux/php-project-autopilot": "dev-master",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.4",
        "psalm/plugin-mockery": "^1.2",
        "psalm/plugin-phpunit": "^0.19.3",
        "psalm/plugin-symfony": "^5.2",
        "vimeo/psalm": "^6.5",
        "weirdan/doctrine-psalm-plugin": "^2.10"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Infra\\": "src/RegistroContabile/Infra/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\E2E\\": "tests/E2E/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts",
            "bash vendor/matiux/php-project-autopilot/src/configure.sh"
        ],
        "post-update-cmd": [
            "@auto-scripts",
            "bash vendor/matiux/php-project-autopilot/src/configure.sh"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}
